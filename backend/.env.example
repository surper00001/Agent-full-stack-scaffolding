# =============================================================================
# 应用配置
# =============================================================================
APP_NAME=agent-platform
APP_ENV=development          # development | staging | production
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
APP_SECRET_KEY=change-me-to-a-random-secret-key-at-least-32-chars

# =============================================================================
# 数据库配置（主数据库 - PostgreSQL）
# =============================================================================
DB_HOST=localhost
DB_PORT=5432
DB_USER=agent_user
DB_PASSWORD=change-me
DB_NAME=agent_platform
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_ECHO=false                # 开发时可设为 true 查看 SQL

# =============================================================================
# 向量数据库配置
# =============================================================================
# 支持: chroma | qdrant | pgvector
VECTOR_STORE_TYPE=chroma
# Chroma（VECTOR_STORE_TYPE=chroma 时生效）
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_PERSIST_DIR=./data/chroma
# Qdrant（VECTOR_STORE_TYPE=qdrant 时生效）
# 启动 Qdrant: docker run -p 6333:6333 -p 6334:6334 qdrant/qdrant
# Web UI: http://localhost:6333/dashboard
# QDRANT_HOST=localhost
# QDRANT_PORT=6333
# QDRANT_API_KEY 留空（本地开发无需认证）
# QDRANT_PREFER_GRPC=false
# 如果使用 pgvector：
# PGVECTOR_CONNECTION_STRING=postgresql+asyncpg://user:pass@localhost:5432/vector_db

# =============================================================================
# Redis 配置（缓存 / 会话 / LangGraph checkpoint）
# =============================================================================
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# =============================================================================
# LLM 配置
# =============================================================================
# DeepSeek（默认，兼容 OpenAI API，性价比高）
DEEPSEEK_API_KEY=sk-xxx
DEEPSEEK_API_BASE=https://api.deepseek.com/v1
DEEPSEEK_DEFAULT_MODEL=deepseek-chat

# OpenAI（备选）
OPENAI_API_KEY=sk-xxx
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_DEFAULT_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Anthropic（备选）
ANTHROPIC_API_KEY=sk-ant-xxx
ANTHROPIC_DEFAULT_MODEL=claude-sonnet-4-6

# 默认使用的 LLM 提供商: deepseek | openai | anthropic
LLM_PROVIDER=deepseek

# =============================================================================
# 监测配置（全开源方案：LangFuse + OpenTelemetry）
# =============================================================================
MONITORING_ENABLED=true
MONITORING_PROVIDER=langfuse     # langfuse | otel

# LangFuse（开源 LLM 监测平台，https://github.com/langfuse/langfuse）
LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key
LANGFUSE_HOST=https://cloud.langfuse.com

# OpenTelemetry（备选/增强，可自建 Jaeger/Tempo 等）
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# OTEL_SERVICE_NAME=agent-platform

# =============================================================================
# 多租户配置
# =============================================================================
MULTI_TENANT_ENABLED=false      # 是否启用多租户
TENANT_HEADER_NAME=x-tenant-id  # 租户 ID 请求头名称

# =============================================================================
# 安全配置
# =============================================================================
RATE_LIMIT_ENABLED=true         # 是否启用 API 限流（Redis 滑动窗口）
# =============================================================================
JWT_SECRET_KEY=change-me-jwt-secret-at-least-32-chars-long
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30    # Access Token 过期时间（分钟）
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7       # Refresh Token 过期时间（天）

# =============================================================================
# 验证码配置
# =============================================================================
VERIFICATION_CODE_TTL=300             # 验证码有效期（秒），默认 5 分钟

# =============================================================================
# Agent 配置
# =============================================================================
AGENT_MAX_ITERATIONS=15
AGENT_MAX_EXECUTION_TIME=300    # 最大执行时间（秒）
AGENT_CHECKPOINT_SAVE_INTERVAL=5

# Plan 模型（可独立选择推理能力更强的模型做规划）
# 留空则复用执行模型。推荐: deepseek-r1, o1-mini, claude-sonnet-4-6
PLAN_MODEL_NAME=

# =============================================================================
# 博查 Web Search 配置
# =============================================================================
BOCHA_API_KEY=sk-your-bocha-api-key
BOCHA_API_BASE=https://api.bochaai.com/v1/web-search

# =============================================================================
# 管理员配置（首次启动自动创建，后续修改密码请在管理后台或数据库操作）
# =============================================================================
ADMIN_USERNAME=admin_tt
ADMIN_PASSWORD=change-me-to-a-strong-password
ADMIN_EMAIL=admin@agent-platform.local

# =============================================================================
# 文件输出配置
# =============================================================================
FILE_OUTPUT_DIR=./data/outputs
FILE_DOWNLOAD_URL_PREFIX=/api/v1/files

# =============================================================================
# Harness Engineering — AI 自进化平台
# =============================================================================
HARNESS_ENABLED=true                     # 是否启用 Harness Engineering
HARNESS_SANDBOX_ENABLED=true             # 启用沙箱隔离执行
HARNESS_SANDBOX_POOL_SIZE=3              # 沙箱池预热数量
HARNESS_SANDBOX_MAX_POOL_SIZE=10         # 最大沙箱数量
HARNESS_SANDBOX_TIMEOUT=60               # 默认执行超时（秒）
HARNESS_SANDBOX_PREFER_DOCKER=true       # 优先使用 Docker 沙箱（WSL2）
HARNESS_AUTO_APPROVE_LOW=true            # Low 安全级别自动通过审核
HARNESS_MAX_CODE_LENGTH=10000            # Skill 代码最大字符数
# WSL2 容器运行用户（安全：非 root），默认 sandboxuser:1000
# HARNESS_SANDBOX_USER=sandboxuser
# HARNESS_SANDBOX_UID=1000

# =============================================================================
# 上下文管理
# =============================================================================
CONTEXT_MAX_TOKENS=128000       # 对话上下文窗口上限（token）
CONTEXT_RESPONSE_RESERVE=8192   # 预留给模型输出的 token
CONTEXT_STRATEGY=hybrid         # sliding_window | summarize | selective | hybrid

# =============================================================================
# 知识库配置
# =============================================================================
KB_STORAGE_DIR=./data/knowledge_bases         # 源文件存档目录
KB_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B   # Embedding 模型（sentence-transformers 格式）
KB_RERANKER_MODEL=Qwen/Qwen3-Reranker-0.6B   # Reranker 模型（Qwen3 专用打分接口）
KB_HYBRID_SEARCH_ENABLED=true                  # 是否启用 BM25+向量混合检索
KB_CHAT_AUTO_RETRIEVE=true                     # 聊天时自动预检索知识库
KB_CHAT_RETRIEVE_TOP_K=5                       # 聊天预检索返回条数
KB_RERANK_MIN_SCORE=0.25                       # 重排序最低分数阈值（0-1）
KB_SEARCH_MMR_ENABLED=true                     # 是否启用 MMR 多样化去重
KB_SEARCH_MMR_LAMBDA=0.7                       # MMR 平衡系数（越大越偏向相关性）
KB_DEFAULT_CHUNK_SIZE=768                      # 默认分块大小（字符数）
KB_DEFAULT_CHUNK_OVERLAP=128                   # 默认分块重叠（字符数）
KB_PARENT_CHUNK_SIZE=2000                      # 父块大小（扩展上下文用）
KB_SEARCH_TOP_K=5                              # 向量检索返回数量
KB_RERANKER_TOP_K=3                            # 重排序后返回数量
KB_MAX_FILE_SIZE_MB=50                         # 单文件最大上传大小（MB）
KB_OCR_ENABLED=true                            # 是否启用 PaddleOCR
KB_OCR_LANG=ch                                 # OCR 语言（ch=中英文混合）
KB_PAGE_OCR_FALLBACK=true                      # PDF 无文本页整页 OCR 回退
KB_EMBEDDING_DEVICE=auto                       # 设备: auto | cpu | cuda
HF_ENDPOINT=https://hf-mirror.com              # HuggingFace 镜像（国内加速，留空走官方源）
HF_TOKEN=                                       # HuggingFace Token（https://huggingface.co/settings/tokens）

# Redis 缓存（Embedding + 搜索结果）
KB_EMBEDDING_CACHE_ENABLED=true                # Embedding 向量 Redis 缓存
KB_EMBEDDING_CACHE_TTL=86400                   # Embedding 缓存 TTL（秒，默认 24h）
KB_SEARCH_CACHE_ENABLED=true                   # 搜索结果 Redis 缓存
KB_SEARCH_CACHE_TTL=300                        # 搜索缓存 TTL（秒，默认 5min）

# =============================================================================
# 视觉语言模型 VLM（OCR 增强 / 图像描述 / 参考文献提取兜底）
# =============================================================================
VLM_ENABLED=true                                 # 是否启用 VLM（Qwen3-VL-Flash）
VLM_MODEL=qwen3-vl-flash                         # 图像理解模型名称
DASHSCOPE_API_KEY=sk-your-dashscope-key          # 阿里云 DashScope API Key（参考文献提取兜底必备）
DASHSCOPE_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1

# =============================================================================
# PDF 解析器 & MinerU（深度学习版面分析）
# =============================================================================
KB_PDF_PARSER=auto                               # default | mineru | auto（auto=自动检测 MinerU，可用则优先）
MINERU_DEVICE=cpu                                # MinerU 推理设备: cpu | cuda
# MINERU_MODELS_DIR=                             # MinerU 模型目录（留空使用默认路径）
# MINERU_MODEL_SOURCE=modelscope                 # MinerU 模型来源: huggingface | modelscope | local
# MINERU_BACKEND=pipeline                        # MinerU 后端: pipeline（通用）

# VLM 表格提取（Qwen3-VL-Flash 从 PDF 图片中发现表格）
KB_VLM_TABLE_EXTRACTION=true                     # 是否使用 VLM 发现图片中的表格
KB_VLM_TABLE_EXTRACTION_MAX_PAGES=5              # 每个文档最多 VLM 表格提取页数（控制成本）

# Query 改写（HyDE）
KB_QUERY_REWRITE_ENABLED=true                    # 短 query 自动生成假设文档提升召回
KB_QUERY_REWRITE_MIN_CHARS=20                    # Query 低于此字符数触发改写
# KB_QUERY_REWRITE_MODEL=                        # 改写专用模型（留空复用执行模型）

# Reranker 两阶段剪枝
KB_RERANKER_PRUNING_ENABLED=true                 # 两阶段剪枝：先 15 条，高分则止
KB_RERANKER_FIRST_PASS_COUNT=15                  # 第一阶段候选数
KB_RERANKER_PRUNING_THRESHOLD=0.5                # 最高分≥此值跳过第二阶段

# Embedding 攒批
KB_EMBEDDING_BATCH_WAIT_MS=50                    # 攒批等待窗口（毫秒），0=禁用
KB_EMBEDDING_BATCH_MAX=64                        # 攒批最大合并条数
